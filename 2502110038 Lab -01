
IT-12
when green flag clicked
go to x: 0 y: 0
say "Welcome! Let's make chai." for 2 seconds
move 50 steps
say "Take a cup." for 2 seconds
wait 1 seconds
move 50 steps
say "Add tea and sugar." for 2 seconds
wait 1 seconds
say "Pour hot milk." for 2 seconds
move 50 steps
say "Your chai is ready!" for 2 seconds

IT-10
when green flag clicked
set Parts Produced to 0

repeat 5
    move 100 steps
    say "STAMP!" for 1 seconds
    change Parts Produced by 1
    move -100 steps

IT-08
when green flag clicked
ask "Enter part diameter:" and wait
set Diameter to answer
if <(Diameter >= 45) and (Diameter <= 55)> then
    say "ACCEPT - Part is within limits"
else
    say "REJECT - Part is outside limits"

IT-06
when green flag clicked

set Accepted to 0
set Rejected to 0
repeat 10

    set Diameter to pick random 40 to 60

    if <(Diameter >= 45) and (Diameter <= 55)> then

        change Accepted by 1
        say "ACCEPT" for 1 seconds

    else

        change Rejected by 1
        say "REJECT" for 1 seconds

    end

end
say (join "10 inspected. "
    (join Accepted
        (join " accepted, "
            (join Rejected " rejected."))))


